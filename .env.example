# Optional Alpha Vantage news source.
ALPHAVANTAGE_API_KEY=

# Optional Next.js -> FastAPI proxy target (frontend server-side only).
FINBERT_BACKEND_URL=http://127.0.0.1:8000

# Optional model override.
FINBERT_MODEL_NAME=ProsusAI/finbert

# Optional HTTP timeout.
REQUEST_TIMEOUT_SECONDS=30

# Optional transcript controls.
TRANSCRIPT_TARGET_COUNT=4

# Optional OpenAI transcript normalizer.
OPENAI_API_KEY=
OPENAI_NORMALIZER_MODEL=gpt-4o-mini

# Optional OpenAI model for deterministic Motley discovery/scrape fallback.
OPENAI_SEARCH_MODEL=gpt-5-mini

# Transcript pipeline mode.
TRANSCRIPT_PIPELINE_MODE=motley_cli
TRANSCRIPT_PIPELINE_FALLBACK_TO_LEGACY=1

# Deterministic Motley discovery/scrape defaults (dev profile).
MOTLEY_TIMEOUT_SECONDS=45
MOTLEY_OPENAI_RETRIES=3
MOTLEY_DISCOVERY_MODE=hybrid
MOTLEY_SITEMAP_LOOKBACK_MONTHS=24
MOTLEY_AUTHOR_MAX_PAGES=0
MOTLEY_SCRAPE_COUNT=4
MOTLEY_SCRAPE_CACHE_MODE=refresh
MOTLEY_DISCOVERY_CACHE_MODE=refresh
MOTLEY_SCRAPE_CACHE_DIR=output/openai_motley_cache
MOTLEY_DISCOVERY_CACHE_DIR=output/openai_motley_discovery_cache

# Long speaker-block sentiment segmentation.
TRANSCRIPT_SENTIMENT_SEGMENT_CHARS=650
TRANSCRIPT_SENTIMENT_SEGMENT_MAX=1000
TRANSCRIPT_SENTIMENT_SEGMENT_MIN=180
TRANSCRIPT_SENTIMENT_SEGMENT_OVERLAP_SENTENCES=1

# Optional hybrid transcript feature classifier (lexical + OpenAI block classification).
TRANSCRIPT_FEATURE_AI_ENABLED=1
TRANSCRIPT_FEATURE_AI_MODEL=gpt-4o-mini
TRANSCRIPT_FEATURE_AI_WEIGHT=0.35
TRANSCRIPT_FEATURE_AI_MAX_BLOCKS=80
TRANSCRIPT_FEATURE_AI_BATCH_SIZE=20
TRANSCRIPT_FEATURE_AI_TIMEOUT_SECONDS=12

# Hybrid student metric rollout (block-level communication metrics).
USE_STUDENT_CONFIDENCE=1
USE_STUDENT_DIRECTNESS=1
USE_STUDENT_OUTLOOK_STRENGTH=1
USE_STUDENT_SPECIFICITY=0
USE_STUDENT_RISK_INTENSITY=0
STUDENT_METRICS_SHADOW_COMPARE=1
STUDENT_METRICS_FORCE_LEXICAL_FALLBACK=0
STUDENT_METRICS_SPECIFICITY_BLEND_ENABLED=0
STUDENT_METRICS_SPECIFICITY_BLEND_WEIGHT=0.35
STUDENT_METRICS_BATCH_SIZE=8
STUDENT_METRICS_MAX_LENGTH=256
STUDENT_MODEL_CONFIDENCE_DIR=output/student_models/confidence_three_band_deberta_v3_base_strict070/model
STUDENT_MODEL_DIRECTNESS_DIR=output/student_models/directness_three_band_deberta_v3_base_strict070/model
STUDENT_MODEL_OUTLOOK_STRENGTH_DIR=output/student_models/outlook_strength_five_band_deberta_v3_base_strict070/model
STUDENT_MODEL_SPECIFICITY_DIR=output/student_models/specificity_deberta_v3_base_cpu/model
STUDENT_MODEL_RISK_INTENSITY_DIR=output/student_models/risk_intensity_three_band_deberta_v3_base_strict070/model

# News/social breadth controls.
NEWS_LIMIT=50
NEWS_POOL_SIZE=240
NEWS_LOOKBACK_DAYS=21
NEWS_ENABLE_ALPHA_VANTAGE=1
NEWS_ENABLE_YAHOO_FINANCE=1
SOCIAL_LIMIT=50
SOCIAL_POOL_SIZE=260
SOCIAL_LOOKBACK_DAYS=21
SOCIAL_ENABLE_REDDIT=1
SOCIAL_ENABLE_STOCKTWITS=1
